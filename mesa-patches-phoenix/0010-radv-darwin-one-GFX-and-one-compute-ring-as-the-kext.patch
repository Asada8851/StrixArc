From ba164800569cf5b67e9b03132f32ba1babeaa910 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 00:32:48 +0300
Subject: [PATCH] radv/darwin: one GFX and one compute ring, as the kext runs

The canned devices carry the Linux ring masks (compute 0xf), so RADV
offered four compute queues while PhxBringup takes ring 0 only. A client
that spreads its work over the queues (FFmpeg's transfer queue for frame
downloads) had every submission on queue 1..3 rejected with EINVAL, the
context was lost, and VCN decode looked broken although it ran.
---
 src/amd/common/darwin/ac_darwin_drm.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/amd/common/darwin/ac_darwin_drm.c b/src/amd/common/darwin/ac_darwin_drm.c
index 132f68c..d864269 100644
--- a/src/amd/common/darwin/ac_darwin_drm.c
+++ b/src/amd/common/darwin/ac_darwin_drm.c
@@ -530,10 +530,16 @@ acd_info(struct acd_device *dev, const struct drm_amdgpu_info *info)
       *(uint32_t *)out = 1;
       return 0;
    case AMDGPU_INFO_HW_IP_INFO:
-      if (info->query_hw_ip.type == AMDGPU_HW_IP_GFX)
+      /* The kext runs one ring per engine and refuses any other (ib.ring != 0). The canned devices carry the Linux
+       * masks (compute 0xf), so RADV offered four compute queues, and a client that spreads its work over them
+       * (FFmpeg's transfer queue) had every submission past the first rejected with EINVAL: one of each, here. */
+      if (info->query_hw_ip.type == AMDGPU_HW_IP_GFX) {
          *(struct drm_amdgpu_info_hw_ip *)out = d->hw_ip_gfx;
-      else if (info->query_hw_ip.type == AMDGPU_HW_IP_COMPUTE)
+         ((struct drm_amdgpu_info_hw_ip *)out)->available_rings &= 0x1;
+      } else if (info->query_hw_ip.type == AMDGPU_HW_IP_COMPUTE) {
          *(struct drm_amdgpu_info_hw_ip *)out = d->hw_ip_compute;
+         ((struct drm_amdgpu_info_hw_ip *)out)->available_rings &= 0x1;
+      }
       else if (info->query_hw_ip.type == AMDGPU_HW_IP_VCN_ENC && acd_vcn(dev, NULL))
          *(struct drm_amdgpu_info_hw_ip *)out = (struct drm_amdgpu_info_hw_ip){
             .hw_ip_version_major = 4, .hw_ip_version_minor = 0, .ib_start_alignment = 256, .ib_size_alignment = 4,
-- 
