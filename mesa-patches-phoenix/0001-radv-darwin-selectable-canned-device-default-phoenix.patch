From c27065c0c21c5247bc68a04c6f9bb83e31002c4e Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Sun, 18 Oct 2026 12:21:51 -0700
Subject: [PATCH 1/3] radv/darwin: selectable canned device, default phoenix
 (gfx1103)

---
 src/amd/common/darwin/ac_darwin_drm.c  | 40 +++++++++++++++++++++++---
 src/amd/common/darwin/ac_darwin_drm.h  |  5 ++++
 src/amd/common/darwin/ac_darwin_mock.c |  8 ++++--
 3 files changed, 46 insertions(+), 7 deletions(-)

diff --git a/src/amd/common/darwin/ac_darwin_drm.c b/src/amd/common/darwin/ac_darwin_drm.c
index 9e35f84..f23ef8f 100644
--- a/src/amd/common/darwin/ac_darwin_drm.c
+++ b/src/amd/common/darwin/ac_darwin_drm.c
@@ -86,6 +86,38 @@ static struct acd_core *g_core;
       return -ENODEV;                                                                             \
    } while (0)
 
+static const struct amdgpu_device *
+find_canned(const char *name);
+
+/* Canned device selection: RADV_DARWIN_CANNED names an amdgpu_devices[] entry, default "phoenix"
+ * (Radeon 780M / gfx1103 / GC 11.0.1). The values that used to be gfx1201 constants come from it. */
+const struct amdgpu_device *
+acd_canned_device(void)
+{
+   const char *name = getenv("RADV_DARWIN_CANNED");
+   return find_canned(name && *name ? name : "phoenix");
+}
+
+uint32_t
+acd_canned_gb_addr_config(const struct amdgpu_device *d)
+{
+   for (uint32_t i = 0; i + 2 < ARRAY_SIZE(d->mmr_regs) && d->mmr_regs[i]; i += 3) {
+      if (d->mmr_regs[i] == ACD_GB_ADDR_CONFIG_REG)
+         return d->mmr_regs[i + 2];
+   }
+   return 0;
+}
+
+uint32_t
+acd_canned_gc_version(const struct amdgpu_device *d)
+{
+   switch (d->dev.family) {
+   case AMDGPU_FAMILY_GC_11_0_1: return (11u << 16) | (0u << 8) | 1u;
+   case AMDGPU_FAMILY_GC_12_0_0: return (12u << 16) | (0u << 8) | 1u;
+   default: return 0;
+   }
+}
+
 static const struct amdgpu_device *
 find_canned(const char *name)
 {
@@ -153,10 +185,10 @@ acd_native_handshake(struct acd_kext *kext, const struct amdgpu_device *canned,
          return r;
       }
    }
-   if (gb != ACD_GB_ADDR_CONFIG_GFX1201 && !env_is_1("RADV_DARWIN_ALLOW_ADDRCFG")) {
-      fprintf(stderr, "radv-darwin: live GB_ADDR_CONFIG 0x%08x != canned gfx1201 0x%08x (set "
+   if (gb != acd_canned_gb_addr_config(canned) && !env_is_1("RADV_DARWIN_ALLOW_ADDRCFG")) {
+      fprintf(stderr, "radv-darwin: live GB_ADDR_CONFIG 0x%08x != canned %s 0x%08x (set "
                       "RADV_DARWIN_ALLOW_ADDRCFG=1 to override)\n",
-              gb, ACD_GB_ADDR_CONFIG_GFX1201);
+              gb, canned->name, acd_canned_gb_addr_config(canned));
       return -ENODEV;
    }
 
@@ -257,7 +289,7 @@ acd_device_initialize(uint32_t *drm_major, uint32_t *drm_minor, acd_device_handl
    if (!dev)
       return -ENOMEM;
 
-   dev->canned = find_canned("gfx1201");
+   dev->canned = acd_canned_device();
    if (!dev->canned) {
       free(dev);
       return -ENODEV;
diff --git a/src/amd/common/darwin/ac_darwin_drm.h b/src/amd/common/darwin/ac_darwin_drm.h
index 0d92684..1db9014 100644
--- a/src/amd/common/darwin/ac_darwin_drm.h
+++ b/src/amd/common/darwin/ac_darwin_drm.h
@@ -80,6 +80,11 @@ int acd_sync_cs_wait_ready(struct util_sync_provider *p, uint32_t handle, uint64
 /* CS path: attaches the returned seqno to (handle, point); point 0 = binary payload. */
 int acd_sync_cs_attach(struct util_sync_provider *p, uint32_t handle, uint64_t point, uint64_t seq);
 
+struct amdgpu_device;
+const struct amdgpu_device *acd_canned_device(void);
+uint32_t acd_canned_gb_addr_config(const struct amdgpu_device *d);
+uint32_t acd_canned_gc_version(const struct amdgpu_device *d);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/amd/common/darwin/ac_darwin_mock.c b/src/amd/common/darwin/ac_darwin_mock.c
index b7588d5..240f202 100644
--- a/src/amd/common/darwin/ac_darwin_mock.c
+++ b/src/amd/common/darwin/ac_darwin_mock.c
@@ -14,6 +14,7 @@
  */
 
 #include "ac_darwin_kext.h"
+#include "ac_darwin_drm.h"
 
 #include <errno.h>
 #include <pthread.h>
@@ -611,8 +612,8 @@ mock_call(void *ctx, uint32_t sel, const uint64_t *sin, uint32_t nsin, const voi
       inf.reserved[2] = N48N_ABI_MINOR;
       inf.flags = N48N_INFO_S1B_POSITIVE | N48N_INFO_NATIVE_BOOT;
       inf.vmid = 8;
-      inf.gb_addr_config = ACD_GB_ADDR_CONFIG_GFX1201;
-      inf.gc_version = (12u << 16) | (0u << 8) | 1u;
+      inf.gb_addr_config = acd_canned_gb_addr_config(acd_canned_device());
+      inf.gc_version = acd_canned_gc_version(acd_canned_device());
       inf.ring_size_dw = 4096;
       inf.max_ibs = N48N_MAX_IBS;
       inf.vram_vis_total = MOCK_VIS_TOTAL;
@@ -640,7 +641,8 @@ mock_call(void *ctx, uint32_t sel, const uint64_t *sin, uint32_t nsin, const voi
       NEED(sin[1] >= 1 && sin[1] <= 16 && sin[2] == 0xFFFFFFFFull && shape(3, 0, 0, sin[1] * 4));
       uint32_t v[16] = {0};
       for (uint64_t i = 0; i < sin[1]; i++)
-         v[i] = (sin[0] + i == ACD_GB_ADDR_CONFIG_REG) ? ACD_GB_ADDR_CONFIG_GFX1201 : 0;
+         v[i] = (sin[0] + i == ACD_GB_ADDR_CONFIG_REG)
+                    ? acd_canned_gb_addr_config(acd_canned_device()) : 0;
       memcpy(stout, v, sin[1] * 4);
       *stoutsz = sin[1] * 4;
       break;
-- 
