+/* Bytes per pixel of the formats texture updates go to; 0: not handled by the upload buffers (staging texture). */
+static NSUInteger METAL_UploadBytesPerPixel(MTLPixelFormat format)
+{
+    switch (format) {
+    case MTLPixelFormatR8Unorm: return 1;
+    case MTLPixelFormatRG8Unorm: case MTLPixelFormatR16Unorm: return 2;
+    case MTLPixelFormatBGRA8Unorm: case MTLPixelFormatRGBA8Unorm: case MTLPixelFormatRG16Unorm: return 4;
+    default: return 0;
+    }
+}
+
+/* A shared buffer of at least len bytes: the smallest one the GPU is done with (a Y plane's buffer is not spent on
+ * a chroma plane), else a new one. */
+static id<MTLBuffer> METAL_TakeUploadBuffer(METAL_RenderData *data, NSUInteger len)
+{
+    NSMutableArray<id<MTLBuffer>> *pool = data.uploadpool;
+    if (pool != nil) {
+        @synchronized(pool) {
+            NSUInteger best = NSNotFound;
+            for (NSUInteger i = 0; i < pool.count; i++) {
+                if (pool[i].length >= len && (best == NSNotFound || pool[i].length < pool[best].length)) {
+                    best = i;
+                }
+            }
+            if (best != NSNotFound) {
+                id<MTLBuffer> buf = pool[best];
+                [pool removeObjectAtIndex:best];
+                return buf;
+            }
+        }
+    }
+    return [data.mtldevice newBufferWithLength:len options:MTLResourceStorageModeShared];
+}
